# CC Switch writes the active provider into ~/.codex/config.toml.
# Leon Agent reads that file on startup and follows the current URL/key/model.
LLM_SOURCE=toml
# CODEX_CONFIG_PATH=C:\Users\Administrator\.codex\config.toml

# optional legacy CC Switch DB source
# LLM_SOURCE=ccs
# CCS_APP=codex
# CCS_PROVIDER=current

# optional manual fallback
# LLM_SOURCE=env
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-xx

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
LOG_LEVEL=INFO

# Leon Agent -> existing Leon/ComfyUI image pipeline
LEON_BACKEND_URL=http://192.168.8.100:8188
# Base URL used to build absolute image links returned to the user.
# Leave empty to reuse LEON_BACKEND_URL, or set a public host such as:
# LEON_PUBLIC_IMAGE_BASE_URL=https://comfyui.928886540.xyz
LEON_PUBLIC_IMAGE_BASE_URL=
# Optional when both repositories share D:\apiWorkSpace; the CLI discovers this path automatically.
# LEON_PLUGIN_DIR=D:\apiWorkSpace\ComfyUI-aki\ComfyUI-aki-v3\ComfyUI\app\ios\plugin\leon-image
LEON_DEFAULT_IMAGE_MODES=k2_tifa_plus
LEON_HTTP_TIMEOUT_SECONDS=30
LEON_BRIDGE_TIMEOUT_SECONDS=20
# Optional UTF-8 text file appended verbatim to the Agent system prompt.
# Relative paths resolve from the repository root; keep private prompts under
# the gitignored data/system-prompts directory.
# LEON_SYSTEM_PROMPT_FILE=data/system-prompts/system-prompt.txt

# Required before exposing the Web Gateway through Cloudflare Tunnel.
# Generate a long random value and keep the real value only in .env.
LEON_API_TOKEN=replace-with-a-long-random-secret
# Keep legacy until the Vue client migration is complete. Set to vue after `npm run build`.
LEON_WEB_CLIENT=legacy

# Volink TTS (语音合成)。留空则语音功能自动关闭。
VOLINK_API_KEY=
VOLINK_BASE_URL=https://api.volink.org/v1
# 默认音色 id（24 位 hex，必须用 id 不能用名字）。示例为「风韵少妇」。
VOLINK_DEFAULT_VOICE_ID=689334e84d3396ad1d28ee9e
