# ai-workbench now reads providers from local CC Switch by default.
# Just tell Codex: use CCS provider 薄荷 / 大黑客 / current

LLM_SOURCE=ccs
CCS_APP=codex
CCS_PROVIDER=current

# optional manual fallback
# LLM_SOURCE=env
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-xx

LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LOG_LEVEL=INFO

# Leon Agent -> existing Leon/ComfyUI image pipeline
LEON_BACKEND_URL=http://192.168.8.100:8188
# Base URL used to build absolute image links returned to the user.
# Leave empty to reuse LEON_BACKEND_URL, or set a public host such as:
# LEON_PUBLIC_IMAGE_BASE_URL=https://comfyui.928886540.xyz
LEON_PUBLIC_IMAGE_BASE_URL=
# Optional when both repositories share D:\apiWorkSpace; the CLI discovers this path automatically.
# LEON_PLUGIN_DIR=D:\apiWorkSpace\ComfyUI-aki\ComfyUI-aki-v3\ComfyUI\app\ios\plugin\leon-image
LEON_DEFAULT_IMAGE_MODES=k2_tifa
LEON_HTTP_TIMEOUT_SECONDS=30
LEON_BRIDGE_TIMEOUT_SECONDS=20
